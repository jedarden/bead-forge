[Unit]
Description=Periodic git checkpoint of .beads/issues.jsonl (ADR-1)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=%h
Environment=PATH=/usr/bin:/bin
Environment=TMPDIR=/tmp
# Target the bead-forge workspace explicitly. User services start in $HOME, so
# without this the script's PWD fallback would resolve to $HOME rather than the
# repo. bf-checkpoint.sh honors $BF_WORKSPACE above $PWD for exactly this case.
Environment=BF_WORKSPACE=%h/bead-forge
# Debian/Ubuntu portable variant: install deploy/bf-checkpoint.sh to
# ~/.local/bin/bf-checkpoint.sh. The script itself prepends ~/.local/bin (where
# `bf` lives) and /run/current-system/sw/bin (NixOS git, no-op here) to PATH.
ExecStart=%h/.local/bin/bf-checkpoint.sh
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# --- NOTES -------------------------------------------------------------------
# INERT BY DEFAULT: enabling this timer has no side effect until
# `checkpoint.enabled: true` is set in .beads/config.yaml for the workspace.
# bf-checkpoint.sh prints "checkpoint disabled" and exits 0 otherwise, so new
# rollouts stay dormant until a maintainer opts in.
#
# PUSH OFF BY DEFAULT: commits stay local. To push after each checkpoint, set
# `checkpoint.push: true` in .beads/config.yaml — do NOT add --push to
# ExecStart, which would force-push on every timer fire.
