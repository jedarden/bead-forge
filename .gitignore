# Rust/Cargo build artifacts
/target/
Cargo.lock

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Backup files
*.bak
*.backup
*.old

# Temporary files
*.tmp
*.temp

# Python cache
__pycache__/

# bead-forge local-only artifacts (Phase 7.9)
# Pre-export JSONL history snapshots and the per-checkout merge anchor are
# recovery/merge insurance kept locally, never shared through git.
.beads/.bf_history/
.beads/beads.base.jsonl

# Ad hoc root-level test scripts / stray binaries (bf-3o9 hygiene guard).
# Root-anchored (leading /) so these ONLY match files directly in the repo
# root — legit tests under tests/ and src/**/tests/*.rs stay tracked. Pairs
# with the root-ad-hoc-files rule in repo_hygiene.sh (defense in depth).
/test_*.sh
/test_*.py
/test_*.rs
/test_version
# Stray root-level test-output logs (e.g. `cargo test > test-run.log`).
# Same root-anchored rule: only files directly in the repo root, so logs
# under tests/ or target/ stay unaffected.
/test-run.log
/test-*.log
